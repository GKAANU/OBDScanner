{
  "expo": {
    "name": "Otova",
    "slug": "otova",
    "scheme": "otova",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.otova.scanner",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Otova, OBD-II adaptörünüze yerel ağ üzerinden bağlanır. Hiçbir veri internete gönderilmez.",
        "NSBonjourServices": ["_obd._tcp"]
      }
    },
    "android": {
      "package": "com.otova.scanner",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ]
  }
}
