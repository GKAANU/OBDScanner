{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_TESTER_UNLOCK": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6815600896",
        "appleTeamId": "CSMUJR4H57"
      }
    }
  }
}
